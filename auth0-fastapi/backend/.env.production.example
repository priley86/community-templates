# Production Environment Variables for Deployment
# Copy this file to .env.production and fill in your values
# This file is used by deploy-langgraph.sh and deploy-backend.sh scripts

# Google Cloud Platform Configuration
GCP_PROJECT_ID="your-project-id"
GCP_REGION="us-central1"

# Auth0 Configuration
AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_CLIENT_ID="your-client-id"
AUTH0_CLIENT_SECRET="your-client-secret"
AUTH0_SECRET="your-secret-key"  # Generate with: openssl rand -hex 32

# LLM API Key (required for the AI assistant to work)
# For Google Gemini (default): Get your key at https://aistudio.google.com/app/apikey
# For OpenAI: Get your key at https://platform.openai.com/api-keys
# This template supports both - see GEMINI.md for switching between providers
GOOGLE_API_KEY=""

# App Base URL (set after deploying frontend)
APP_BASE_URL=""  # e.g., https://your-frontend-app.a.run.app

# LangGraph Configuration (set after deploying LangGraph server)
LANGGRAPH_EXTERNAL_URL=""  # e.g., https://langgraph-server-xxx-uc.a.run.app

# Optional: LangSmith Tracing
LANGCHAIN_API_KEY=""
LANGCHAIN_TRACING_V2="false"

# Frontend Configuration (set after deploying frontend)
FRONTEND_HOST=""  # e.g., https://your-frontend-app.a.run.app
BACKEND_CORS_ORIGINS=""  # e.g., https://your-frontend-app.a.run.app
